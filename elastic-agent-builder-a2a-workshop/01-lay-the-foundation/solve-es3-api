#!/bin/bash
set -euo pipefail

ROOT="/root/elastic-workshop"
umask 077
mkdir -p "$ROOT"

WC="/root/elastic-workshop/scripts/workshop-common.sh"
if [ ! -f "$WC" ]; then
  echo "[workshop] FATAL: expected $WC (track bootstrap copy). Re-provision the sandbox." >&2
  exit 1
fi
# shellcheck disable=SC1090
source "$WC"
sync_track_assets "${BASH_SOURCE[0]}"
cp -f "$(workshop_root)/assets/env.template" "$ROOT/env.template"

if [ ! -f "$ROOT/.env" ] || ! grep -q '^O11Y_KIBANA_URL=' "$ROOT/.env" 2>/dev/null; then
  if [ -x "$ROOT/scripts/provision-dual-serverless.sh" ]; then
    bash "$ROOT/scripts/provision-dual-serverless.sh" || true
  fi
fi

if [ -f "$ROOT/.env" ]; then
  # shellcheck disable=SC1090
  set -a
  # shellcheck disable=SC1090
  source "$ROOT/.env"
  set +a
  if [ -n "${O11Y_KIBANA_URL:-}" ] && [ -n "${SECURITY_KIBANA_URL:-}" ]; then
    bash "$ROOT/scripts/render-kibana-proxy.sh" "$ROOT/.env" || true
  fi
  bash "$ROOT/scripts/apply-index-templates.sh" || true
  bash "$ROOT/scripts/load-sample-bulk.sh" || true
fi
